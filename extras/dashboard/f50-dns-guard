#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin:/opt/mu300/busybox-bin
# Track bounded children so service stop also releases their locks/groups.
child=''
cleanup() {
 trap '' TERM INT
 if [ -n "$child" ]; then kill -TERM "$child" 2>/dev/null; wait "$child" 2>/dev/null || true; fi
}
trap cleanup EXIT
trap 'exit 143' TERM INT
bounded() {
 /usr/libexec/f50-bounded "$@" & child=$!
 wait "$child"; rc=$?; child=''
 return "$rc"
}
# Fast detection, bounded reconciliation and a monotonic cooldown prevent flapping.
reconcile() {
 now=$(cut -d. -f1 /proc/uptime)
 previous=$(cat /tmp/f50-dns-guard.last 2>/dev/null)
 case "$previous" in ''|*[!0-9]*) previous=0;; esac
 [ "$previous" -le "$now" ] || previous=0
 if [ "$previous" -gt 0 ] && [ $((now-previous)) -lt 30 ]; then
  touch /tmp/f50-dns-recheck
  return 1
 fi
 printf '%s\n' "$now" > /tmp/f50-dns-guard.last
 if bounded 45 /usr/libexec/f50-dns-route auto >/tmp/f50-dns-guard.log 2>&1; then
  rm -f /tmp/f50-dns-recheck
 else touch /tmp/f50-dns-recheck
 fi
 return 0
}
sleep 10
bad=0; last=''
while :; do
 /usr/libexec/f50-lock sweep /tmp/f50dns-switch.lock
 if [ -d /tmp/f50dns-switch.lock ]; then sleep 5; continue; fi
 agh=$(pidof AdGuardHome); clash=$(pidof clash)
 server=$(uci -q get dhcp.@dnsmasq[0].server)
 state="$agh|$clash|$server"
 port=53
 case "$server" in *127.0.0.1#5353*) port=5353;; *127.0.0.1#7874*) port=7874;; esac
 # Probe the actual selected service: dnsmasq's cache must not hide a dead upstream.
 if /usr/libexec/f50-dns-health "$port"; then
  bad=0
  if [ "$state" != "$last" ] || [ -f /tmp/f50-dns-bypass ] || [ -f /tmp/f50-dns-recheck ]; then
   reconcile || true
  fi
 else
  bad=$((bad+1))
  if [ "$bad" -ge 2 ]; then
   if reconcile; then bad=0; fi
  fi
 fi
 last="$agh|$clash|$(uci -q get dhcp.@dnsmasq[0].server)"
 sleep 10
done
