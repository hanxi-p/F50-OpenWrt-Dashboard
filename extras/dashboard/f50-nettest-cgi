#!/bin/sh
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
deny(){ printf 'Status: %s\r\nContent-Type: text/plain\r\nCache-Control: no-store\r\n\r\n%s\n' "$1" "$2"; exit; }
[ "$REQUEST_METHOD" = POST ] || deny '405 Method Not Allowed' 'POST required'
case "${CONTENT_TYPE:-}" in
 'application/x-f50-download; token='*) direction=download; token=${CONTENT_TYPE#*token=};;
 'application/x-f50-upload; token='*) direction=upload; token=${CONTENT_TYPE#*token=};;
 *) deny '403 Forbidden' 'Invalid test content type';;
esac
export HTTP_X_F50_DIRECTION=$direction
case "$token" in ''|*[!0-9a-f]*) deny '403 Forbidden' 'Invalid token';; esac
[ "${#token}" = 48 ] || deny '403 Forbidden' 'Invalid token'
[ "$token" = "$(cat /tmp/f50-nettest/token 2>/dev/null)" ] || deny '403 Forbidden' 'Invalid token'
exec 9>/tmp/f50-nettest/lock
flock -n 9 || deny '409 Conflict' 'Test busy'
# Recheck under lock: a new prepare must not replace the credential mid-request.
[ "$token" = "$(cat /tmp/f50-nettest/token 2>/dev/null)" ] || deny '403 Forbidden' 'Invalid token'
now=$(cut -d. -f1 /proc/uptime)
started=$(cat /tmp/f50-nettest/started)
case "$started" in ''|*[!0-9]*) deny '403 Forbidden' 'Invalid test';; esac
[ "$now" -ge "$started" ] && [ "$((now-started))" -le 30 ] || deny '403 Forbidden' 'Test expired'
case "$direction:${CONTENT_LENGTH:-0}" in
 download:0|upload:8388608) :;;
 *) deny '400 Bad Request' 'Invalid direction or size';;
esac
count=$(cat /tmp/f50-nettest/count)
case "$count" in ''|*[!0-9]*) deny '403 Forbidden' 'Invalid test';; esac
[ "$count" -lt 256 ] || deny '429 Too Many Requests' 'Test byte limit reached'
echo "$((count+1))" > /tmp/f50-nettest/count
# RAM only, fixed 8MiB per request, at most 2GiB/30s per credential.
/usr/libexec/f50-bounded 15 ucode /usr/libexec/f50-nettest-stream.uc
