{
  "luci-app-routertraffic": {
    "description": "Portable WAN rates and per-device traffic",
    "read": {
      "ubus": {
        "routertraffic": [
          "status",
          "devices",
          "resources",
          "profiles",
          "sessions"
        ]
      },
      "file": {
        "/tmp/f50-traffic/status.json": [
          "read"
        ],
        "/tmp/f50-traffic/history.csv": [
          "read"
        ],
        "/www/luci-static/resources/routertraffic/wan.css": [
          "read"
        ],
        "/www/luci-static/resources/routertraffic/style.css": [
          "read"
        ]
      }
    },
    "write": {
      "ubus": {
        "routertraffic": [
          "rename",
          "bind",
          "detach"
        ]
      }
    }
  }
}
