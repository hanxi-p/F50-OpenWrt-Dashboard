#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1
start_service(){
 mkdir -p /tmp/router-traffic /etc/router-traffic
 chmod 700 /tmp/router-traffic /etc/router-traffic
 local cfg=/etc/router-traffic/config.json ip bits redirect dev
 ip=$(jsonfilter -i "$cfg" -e '@.lan_ip')
 bits=$(jsonfilter -i "$cfg" -e '@.lan_prefix')
 redirect=$(jsonfilter -i "$cfg" -e '@.redirect_port')
 dev=$(jsonfilter -i "$cfg" -e '@.lan_device')
 procd_open_instance source
 procd_set_param command /usr/libexec/router-traffic/flow-account "$ip" "$bits" /tmp/router-traffic/source /tmp/router-traffic/unused "$redirect" "$dev"
 procd_set_param respawn 3600 5 5
 procd_set_param stderr 1
 procd_close_instance
 procd_open_instance ledger
 procd_set_param command /usr/bin/ucode /usr/libexec/router-traffic/collector.uc
 procd_set_param respawn 3600 5 5
 procd_set_param term_timeout 10
 procd_set_param stderr 1
 procd_close_instance
}
